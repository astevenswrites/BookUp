# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# D66: scratch checkpoint for prisma/import-open-library.ts (a resumability
# aid for a one-time manual import, not a fixture) — prisma/seed-data/
# real-catalog.json is the actual committed output, this is not.
/prisma/.import-checkpoint


# prisma skills got installed 3x as symlinks (.agents/.claude/.windsurf all point to the
# same content); Windows git can't store symlinks so each resolves to a full copy — keep
# only the .claude copy (what Claude Code actually reads) and drop the other two
/.agents/skills
/.windsurf/skills
