// See ../../DECISIONS.md (Phase 0 section) for why each field/shape was chosen.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum HeatLevel {
  none
  low
  medium
  high
}

enum Pacing {
  slow_burn
  medium
  fast_paced
}

enum TagCategory {
  genre
  trope
  mood
  content_warning
}

enum SwipeDirection {
  left
  right
}

enum TbrStatus {
  to_read
  reading
  finished
  dnf
}

enum ReadingFrequency {
  casual
  regular
  voracious
}

enum DisplayMode {
  cover_first
  vibe_first
}

enum VibeTheme {
  cozy
  dark
  whimsical
  melancholy
}

model Book {
  id          String   @id @default(cuid())
  title       String
  author      String
  hookLine    String // D14: short evocative card-face sentence, distinct from the full blurb
  blurb       String // longer synopsis, shown in the tap-to-expand detail view
  compTitle   String? // D7: free-text "if you liked X..." hook, not a structured relation yet
  coverUrl    String // D6: always a URL/path, placeholder SVG for now
  // D82: null for the synthetic catalog (no real ISBN exists) and for
  // real-imported books until the backfill (prisma/backfill-isbns.ts) runs
  // — the original import (D66) actually required a real ISBN to accept an
  // edition at all (see EditionInfo in import-open-library.ts), it just
  // never made it into the persisted schema. Existing for CSV-import
  // matching precision (D82/Goodreads-StoryGraph import) — an exact ISBN
  // match beats fuzzy title/author matching whenever both sides have one.
  isbn        String?
  heatLevel   HeatLevel // D2: scalar, not a tag
  pacing      Pacing    // D2: scalar, not a tag
  pageCount   Int
  publishedYear Int
  createdAt   DateTime @default(now())
  // D66: true for real-imported books whose heatLevel/pacing are placeholder
  // defaults and whose trope/mood tags are a low-recall best-effort guess —
  // what makes "needs human review" findable in Prisma Studio. Synthetic
  // catalog rows stay false; they were already deliberately authored.
  needsReview Boolean @default(false)
  // D70: purely curatorial "worth showcasing" flag for /review ("Peek at
  // the deck") — NOT a rating or popularity score (see D67: no
  // ratings/reviews in this app, ever). Set by a one-off curation script
  // from signals that never touch the schema themselves (Open Library
  // popularity used only to rank at curation time, a hand-picked indie/
  // small-press list), same way an editor picks a "staff pick" shelf.
  featured    Boolean @default(false)

  tags      BookTag[]
  swipes    Swipe[]
  tbrEntries TBREntry[]
  dailyPicks DailyPick[]
  weeklyPicks WeeklyPick[]
}

model Tag {
  id       String      @id @default(cuid())
  label    String
  category TagCategory // D1

  books       BookTag[]
  preferences PreferenceTag[]
  currentMoodFor Preference[] @relation("PreferenceCurrentMood")

  @@unique([label, category])
}

model BookTag {
  bookId String
  tagId  String

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookId, tagId])
}

model User {
  id        String   @id // D34: Supabase auth.users.id (uuid) — set explicitly on upsert, never generated here
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  swipes     Swipe[]
  tbrEntries TBREntry[]
  dailyPicks DailyPick[]
  weeklyPicks WeeklyPick[]
}

model Swipe {
  id        String         @id @default(cuid())
  direction SwipeDirection
  createdAt DateTime       @default(now())

  // D45: behavioral signal capture — ms the card sat on top of the stack
  // before the decision, and whether the detail view was expanded first.
  // Both feed getImplicitTagWeights' confidence multiplier; neither is
  // required (older rows / instrumentation gaps are just null/false).
  dwellMs       Int?
  viewedDetails Boolean @default(false)

  // D3: anonymous-first — either userId or sessionId is set, never both null
  userId    String?
  sessionId String?

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([bookId])
}

model TBREntry {
  id        String    @id @default(cuid())
  status    TbrStatus @default(to_read) // D4
  addedAt   DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // D45: stamped once on the first transition into `reading` / into
  // `finished` or `dnf` (never overwritten on a later unrelated update,
  // unlike `updatedAt`) — the reading-outcome signal the research doc calls
  // the highest-quality one available, previously uncapturable at all.
  startedAt  DateTime?
  finishedAt DateTime?

  // D83: set only by the "already read" onboarding flow (markBooksAsRead,
  // lib/alreadyRead.ts) — a book marked this way never went through a real
  // swipe or reading-progress judgment, so it must never feed
  // getImplicitTagWeights (matching.ts) as a preference signal the way an
  // organically-finished book does. It still counts fully for exclusion
  // (getExcludedBookIds doesn't check this flag) — only the *preference
  // weighting* is skipped, not the "don't show me this again" purpose.
  fromOnboardingImport Boolean @default(false)

  // D3: anonymous-first, same pattern as Swipe
  userId    String?
  sessionId String?

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookId, userId, sessionId])
  @@index([userId])
  @@index([sessionId])
}

model Preference {
  id               String            @id @default(cuid())
  heatLevelMax      HeatLevel? // D23: scalar, mirrors Book.heatLevel
  pacing            Pacing? // D23: scalar, mirrors Book.pacing
  readingFrequency  ReadingFrequency?
  favoriteBooksNote String? // D29: freeform cold-start signal, unused by matching until Phase 3
  displayMode       DisplayMode       @default(cover_first) // D31
  themeOverride     VibeTheme? // D33: null = auto-derive from mood tags below
  timezone          String? // D35: IANA tz name, set client-side; null = fall back to UTC for the Today's Picks reset
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // D79: streak tracking (Phase 4) — consecutive local calendar days with
  // at least one swipe. `lastActiveDate` reuses the same "YYYY-MM-DD in the
  // actor's own local timezone" shape as DailyPick.pickDate/WeeklyPick.weekKey
  // (see localDateString, dailyPicks.ts) rather than a UTC timestamp, so a
  // streak doesn't break just because someone swipes late at night in their
  // own timezone.
  currentStreak  Int     @default(0)
  longestStreak  Int     @default(0)
  lastActiveDate String?

  // D3-style anonymous-first pattern; D22 — sessionId is set lazily on first quiz submit
  userId    String? @unique
  sessionId String? @unique

  tags PreferenceTag[]

  // D39: "what do you feel like reading today?" — a single mood tag that
  // reweights the deck on top of the quiz's baseline preferences, sticky
  // until manually changed/cleared (not reset per-session). Independent of
  // `tags` above — not written into PreferenceTag, so clearing it can't
  // lose any quiz-time mood selection.
  currentMoodTagId String?
  currentMood      Tag?    @relation("PreferenceCurrentMood", fields: [currentMoodTagId], references: [id], onDelete: SetNull)
}

// D35: 5 curated picks/day, persisted per (actor, local calendar day) so a
// revisit during the same day shows the same set rather than regenerating.
model DailyPick {
  id        String   @id @default(cuid())
  pickDate  String // YYYY-MM-DD in the actor's own local timezone, not UTC
  createdAt DateTime @default(now())

  userId    String?
  sessionId String?

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookId, pickDate, userId, sessionId])
  @@index([userId, pickDate])
  @@index([sessionId, pickDate])
}

// D75: Phase 3's two roadmap loose ends ("Super Match" + a weekly algorithmic
// drop) turned out to be one selection, not two — both just want "this
// week's best-scoring unseen books," at N=1 vs N=10. One model, one query;
// `rank` (0 = the Super Match, 1+ = the rest of the drop) is what a
// createMany batch can't otherwise guarantee, since every row in one
// INSERT shares the same `createdAt`.
model WeeklyPick {
  id        String   @id @default(cuid())
  weekKey   String // ISO week, e.g. "2026-W38", in the actor's own local timezone
  rank      Int
  createdAt DateTime @default(now())

  userId    String?
  sessionId String?

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookId, weekKey, userId, sessionId])
  @@index([userId, weekKey])
  @@index([sessionId, weekKey])
}

model PreferenceTag {
  preferenceId String
  tagId        String

  preference Preference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)
  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([preferenceId, tagId])
}
