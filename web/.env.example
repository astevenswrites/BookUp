# Local dev (via `prisma dev`): both vars point at the same local instance.
# DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Production (Supabase): these MUST be different connection strings — see DECISIONS.md D17.
# Find both under Supabase dashboard -> Project Settings -> Database -> Connection string.

# Runtime queries — the pooled connection (Transaction mode, port 6543).
# Vercel serverless functions each open their own connection; without pooling this
# exhausts Supabase's connection limit under moderate traffic.
DATABASE_URL="postgres://postgres.[project-ref]:[password]@[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations only (`prisma migrate deploy`) — the direct connection (port 5432).
# The pooler doesn't support the session-level operations migrations need.
DIRECT_URL="postgres://postgres.[project-ref]:[password]@[region].pooler.supabase.com:5432/postgres"
